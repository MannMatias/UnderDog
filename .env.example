# Copiá este archivo como .env (NO se versiona). Astro lo carga en los
# contenedores de Airflow.

# Solo para el seed, si falta include/data/raw/soccer_db/database.sqlite
# (token en https://www.kaggle.com/settings/api).
KAGGLE_API_TOKEN=

# --- Airflow Connection a source-db (conn_id soccer_source_db) ---
# Usuario, contraseña y base tienen que coincidir con source_db.env.
# El host es el nombre del servicio en docker-compose.override.yml.
AIRFLOW_CONN_SOCCER_SOURCE_DB=postgres://soccer:CAMBIAR_PASSWORD@source-db:5432/soccer
