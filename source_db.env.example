# Copiá este archivo como source_db.env (NO se versiona). Son las credenciales
# con las que se crea el contenedor source-db (imagen oficial de PostgreSQL).
# Tienen que coincidir con AIRFLOW_CONN_SOCCER_SOURCE_DB en .env.
# Usá una contraseña sin caracteres especiales (va dentro de una URI).
POSTGRES_USER=soccer
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=soccer
